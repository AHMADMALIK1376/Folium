# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# Local development uses a SEPARATE Supabase project (e.g. "folium-dev"), not
# the production one. Tests create dozens of users and documents on every run;
# pointing this at production would accumulate that in the database holding
# real user data.
#
# From Supabase: Project Settings -> Database -> Connection string -> URI,
# using the SESSION pooler. Not the transaction pooler: Alembic needs session
# mode, and transaction mode breaks prepared statements with asyncpg.
#
# Supabase hands you a URL starting "postgresql://". Change that prefix to
# "postgresql+asyncpg://" or the async driver will not load. Percent-encode any
# of @ : / # appearing in the password.
DATABASE_URL=postgresql+asyncpg://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# The same dev project's URL. The backend derives the JWT issuer and the public
# key endpoint from this, so tokens minted by that project's Auth verify here.
SUPABASE_URL=https://YOUR_DEV_PROJECT_REF.supabase.co

# Must be "development" locally. It gates the interactive API docs at /docs;
# the code default is "production" so an unset value stays safe.
ENVIRONMENT=development

# Comma-separated. localhost and 127.0.0.1 are different origins to a browser,
# and Next.js prints both on startup, so allow both in development.
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Faster alternative: run `docker compose up -d` from the repo root and use
# DATABASE_URL=postgresql+asyncpg://folium:folium@localhost:5433/folium
# The suite takes about 4 seconds locally versus a minute or two over the
# network. Optional — see docker-compose.yml.
